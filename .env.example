# Required for real AI output. Without it the app runs in demo mode.
OPENAI_API_KEY=
# Optional: bill to a specific OpenAI org / project
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Models (defaults shown). Use gpt-image-1 if your org doesn't have gpt-image-2 yet.
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
# Optional shared password for the whole app (HTTP Basic auth, any username)
APP_PASSWORD=
PORT=8787
# Optional: point to your own placements list
# PLACEMENTS_FILE=/data/placements.json
